# Copy to ops/config/meetings.env (git-ignored) at the **pixelAgent repo root**.
#
# Default Google Doc for weekly meeting notes (one rolling doc OR the current
# week's doc). Share the doc with your service account email, or use OAuth —
# see docs/meeting_notes_workflow.md.

# Google Doc ID or full URL (from the address bar when the doc is open)
MEETING_GDOC_ID=

# Path to a Google Cloud service account JSON key (git-ignored).
# Share the meeting notes doc with the service account email as Viewer.
GOOGLE_SERVICE_ACCOUNT_FILE=ops/config/gdoc-service-account.json

# Optional: default Wispr Flow local database (Mac). Used by pull_wispr_context.py.
# WISPR_DB_PATH=~/Library/Application Support/Wispr Flow/flow.sqlite

# Optional: typical meeting window for Wispr filtering (24h, local time)
# MEETING_START=11:00
# MEETING_END=12:30

# --- Anthropic LLM (format_meeting_notes.py + synthesize_state.py) ---
ANTHROPIC_API_KEY=
# Optional override only — default model is claude-sonnet-4-6 (Anthropic Sonnet)
# STATE_LLM_MODEL=claude-haiku-4-5-20251001
# To use OpenAI instead: STATE_LLM_PROVIDER=openai, OPENAI_API_KEY=...

# --- GitHub Actions (post-meeting-sync.yml) — set as repository secrets, not here ---
# ANTHROPIC_API_KEY, MEETING_GDOC_ID, GOOGLE_SERVICE_ACCOUNT_JSON
