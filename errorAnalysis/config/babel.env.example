# Babel configuration for remote HF OSWorld failure analysis.
#
# Copy this file to config/babel.env and edit values if needed.
# scripts/babel/submit_hf_analysis.sh sources it automatically.

export BABEL_USER=andiongu
# Babel login node. Compute nodes are babel-* and are reached via a ProxyJump
# through this host (see docs/babel_hf_orchestration.md).
export BABEL_LOGIN_HOST=login.babel.cs.cmu.edu
export BABEL_LOGIN=${BABEL_USER}@${BABEL_LOGIN_HOST}

# Slurm partitions (per Babel quickstart guide).
# debug:   interactive sessions / smoke tests (srun --partition debug ... --pty bash).
# general: non-interactive GPU batch jobs (sbatch --partition general ...).
# cpu:     CPU-only batch jobs.
# array:   scalable batch array jobs.
# preempt: long preemptible batch jobs.
# Phase 1 analysis is CPU-only, so the default partition is `cpu` with 0 GPUs.
# For a GPU job set BABEL_PARTITION=general, BABEL_GPUS>=1, and BABEL_GPU_TYPE.
export BABEL_PARTITION=cpu
export BABEL_TIME=06:00:00
export BABEL_CPUS=8
# CPU RAM. An `oom_kill` error means CPU memory, not GPU HBM, was exhausted: raise
# this value. Rule of thumb from the guide: for a 48GB-HBM GPU request ~48GB here.
export BABEL_MEM=64G
export BABEL_GPUS=0
# GPU type is REQUIRED in the gres request (gpu:L40S:1, not gpu:1). L40S is the
# most plentiful type on Babel; A100_80GB/A100_40GB/L40 are faster but scarcer.
export BABEL_GPU_TYPE=L40S

# Optional account/QoS. Leave blank unless `sacctmgr show user $USER withassoc`
# or your lab tells you a required account.
export BABEL_ACCOUNT=
export BABEL_QOS=

# Babel filesystem layout.
# home (100GB, all nodes): code + small logs only.
# /data/user_data/<andrewID> (500GB, compute nodes, persistent): HF cache, zips,
#   normalized traces, outputs.
export BABEL_HOME_DIR=/home/${BABEL_USER}
export BABEL_USER_DATA=/data/user_data/${BABEL_USER}
export BABEL_PROJECT_DIR=${BABEL_HOME_DIR}/cua-failure-analysis
export BABEL_DATA_ROOT=${BABEL_USER_DATA}/cua_failure_analysis
export BABEL_OUTPUT_ROOT=${BABEL_DATA_ROOT}/outputs
export BABEL_RAW_ROOT=${BABEL_DATA_ROOT}/hf_raw
export BABEL_WORK_ROOT=${BABEL_DATA_ROOT}/work

# Optional lab group space (8TB, compute nodes only — NOT the login node). Per the
# guide, prefer this for large models/datasets and always work in your own
# subdirectory. Replace <lab> with your lab's group (the guide's example is
# `mattlab`). Leave blank if you have no group allocation; the data root above is
# the fallback. When set, point large HF caches/zips here instead of user_data.
export BABEL_GROUP_DIR=
# export BABEL_GROUP_DIR=/data/group_data/<lab>/${BABEL_USER}

# Node-local scratch (auto-expunged): temporary extraction/work only.
export BABEL_SCRATCH_ROOT=/scratch

# Shared community paths. These are AutoFS mounts; scripts touch full paths to
# trigger mounting before listing.
export BABEL_SHARED_DATASETS=/data/datasets
export BABEL_SHARED_MODELS=/data/models

# Hugging Face caches must not live in /home (it is only 100GB). They go to the
# group space when one is configured (8TB), otherwise to user_data (500GB).
if [[ -n "${BABEL_GROUP_DIR}" ]]; then
  export BABEL_HF_HOME=${BABEL_GROUP_DIR}/cua_failure_analysis/hf
else
  export BABEL_HF_HOME=${BABEL_DATA_ROOT}/hf
fi
export HF_HOME=${BABEL_HF_HOME}
export HF_HUB_CACHE=${BABEL_HF_HOME}/hub
export HF_DATASETS_CACHE=${BABEL_HF_HOME}/datasets

# Dataset/repo defaults for Phase 1.
export OSWORLD_HF_REPO=xlangai/ubuntu_osworld_verified_trajs
export OSWORLD_HF_REVISION=main

# First-package smoke test: small enough to validate the flow, relevant to your RQ.
export OSWORLD_PACKAGE=opencua_agent-opencua_a3b-cot_l2-action_history-3image-Ubuntu-15step.zip
export OSWORLD_MAX_EPISODES=25

# Optional frontier judge (Anthropic Claude API). Leave API key blank for Tier-1 only.
export JUDGE_PROVIDER=anthropic
export ANTHROPIC_API_KEY=
export JUDGE_MODEL=claude-sonnet-4-20250514
export JUDGE_MAX_CALLS=50

# Legacy OpenAI-compatible vLLM judge (optional).
export JUDGE_BASE_URL=
export JUDGE_API_KEY=EMPTY
