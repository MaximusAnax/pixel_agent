<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ packet_id }} — Trace Review</title>
  <link rel="stylesheet" href="review.css">
</head>
<body>
  <div class="topbar">
    <div class="title-row">
      <h1>Paired Trace Review</h1>
      <span class="chip"><b>{{ n_tasks }}</b> tasks</span>
      <span class="chip"><b>{{ n_episodes }}</b> traces</span>
      <span class="chip mono" title="packet id">packet · {{ packet_id }}</span>
      <span class="spacer"></span>
      <label class="hint">Annotator
        <select id="annotator-select" class="annotator-select"></select>
      </label>
      <span id="annotator-banner" class="annotator-banner"></span>
      <button type="button" id="btn-export-all" class="btn">Export labels</button>
      <label class="btn btn-file">Import<input type="file" id="import-file" accept=".json"></label>
    </div>
    <div class="filter-row">
      <input type="text" id="f-search" class="search-input" placeholder="search instruction / task id…">
      <select id="f-domain" class="annotator-select">
        <option value="">all domains</option>
        {% for d in task_groups | map(attribute='domain') | unique | sort %}
        <option value="{{ d }}">{{ d }}</option>
        {% endfor %}
      </select>
      <button type="button" class="qf" data-f="a3b-fail">A3B ✗</button>
      <button type="button" class="qf" data-f="7b-fail">7B ✗</button>
      <button type="button" class="qf" data-f="human-pass">Human ✓</button>
      <button type="button" class="qf" data-f="unlabeled">unlabeled</button>
      <button type="button" class="qf" data-f="labeled">labeled</button>
      <button type="button" class="qf" data-f="judges-disagree" title="offline judges give different primary modes">judges differ</button>
      {% set batch_n = task_groups | selectattr('in_label_batch') | list | length %}
      {% if batch_n %}
      <button type="button" class="qf qf-batch" data-f="batch" title="active annotation batch: human replay passes, both models fail">label batch ({{ batch_n }})</button>
      {% endif %}
      <span class="hint" id="f-count"></span>
    </div>
  </div>

  <table>
    <colgroup>
      <col style="width:8%"><col style="width:7%"><col style="width:30%">
      <col style="width:14%"><col style="width:14%">
      <col style="width:8%"><col style="width:8%"><col style="width:11%">
    </colgroup>
    <thead>
      <tr>
        <th>Domain</th>
        <th>Task</th>
        <th class="instr-col">Instruction</th>
        <th>Judges (A3B)</th>
        <th>Judges (7B)</th>
        <th>abdoul</th>
        <th>raghav</th>
        <th>Open</th>
      </tr>
    </thead>
    <tbody>
      {% for group in task_groups %}
      {% set a3b = group.models.get('a3b', {}) %}
      {% set b7 = group.models.get('7b', {}) %}
      {% set human = group.models.get('human', {}) %}
      {% set instr = instructions.get(group.task_id, '') if instructions is defined else '' %}
      <tr data-domain="{{ group.domain }}"
          data-a3b="{{ 'pass' if a3b.success is sameas true else 'fail' if a3b.success is sameas false else 'unknown' }}"
          data-7b="{{ 'pass' if b7.success is sameas true else 'fail' if b7.success is sameas false else 'unknown' }}"
          data-human="{{ 'pass' if human.success is sameas true else 'fail' if human.success is sameas false else 'unknown' }}"
          data-judges-disagree="{{ '1' if group.judges_disagree else '0' }}"
          data-batch="{{ '1' if group.in_label_batch else '0' }}"
          data-search="{{ (group.task_id ~ ' ' ~ instr) | lower }}">
        <td class="domain-cell">{{ group.domain }}</td>
        <td><code title="{{ group.task_id }}">{{ group.task_id[:8] }}…</code></td>
        <td class="instr-col"><span class="instr-clamp" title="{{ instr }}">{{ instr }}</span></td>
        <td class="judge-cell">
          {% if a3b.provisional_primary or a3b.t_star is not none %}<div>{{ a3b.provisional_primary or '—' }}{% if a3b.t_star is not none %} @ {{ a3b.t_star }}{% endif %}</div>{% elif not a3b.offline %}<span class="empty-cell">—</span>{% endif %}
          {% if a3b.offline %}<div class="oj-line{% if a3b.offline.values() | unique | list | length > 1 %} oj-differ{% endif %}">{% for jn, jp in a3b.offline.items() %}<span class="oj-badge" title="{{ jn }} (offline whole-trajectory judge)"><b>{{ 'Q7' if jn == 'qwen7b' else 'Q32' if jn == 'qwen32b' else jn }}</b>{{ jp or '—' }}</span>{% endfor %}</div>{% endif %}
        </td>
        <td class="judge-cell">
          {% if b7.provisional_primary or b7.t_star is not none %}<div>{{ b7.provisional_primary or '—' }}{% if b7.t_star is not none %} @ {{ b7.t_star }}{% endif %}</div>{% elif not b7.offline %}<span class="empty-cell">—</span>{% endif %}
          {% if b7.offline %}<div class="oj-line{% if b7.offline.values() | unique | list | length > 1 %} oj-differ{% endif %}">{% for jn, jp in b7.offline.items() %}<span class="oj-badge" title="{{ jn }} (offline whole-trajectory judge)"><b>{{ 'Q7' if jn == 'qwen7b' else 'Q32' if jn == 'qwen32b' else jn }}</b>{{ jp or '—' }}</span>{% endfor %}</div>{% endif %}
        </td>
        <td class="label-cell">
          <div><span class="mini">A3B</span><span class="human-status" data-annotator="abdoul" data-label-key="a3b/{{ a3b.episode_id | replace('/', '__') if a3b.episode_id else '' }}">—</span></div>
          <div><span class="mini">7B</span><span class="human-status" data-annotator="abdoul" data-label-key="7b/{{ b7.episode_id | replace('/', '__') if b7.episode_id else '' }}">—</span></div>
        </td>
        <td class="label-cell">
          <div><span class="mini">A3B</span><span class="human-status" data-annotator="raghav" data-label-key="a3b/{{ a3b.episode_id | replace('/', '__') if a3b.episode_id else '' }}">—</span></div>
          <div><span class="mini">7B</span><span class="human-status" data-annotator="raghav" data-label-key="7b/{{ b7.episode_id | replace('/', '__') if b7.episode_id else '' }}">—</span></div>
        </td>
        <td class="links">
          {% if a3b.href %}<a href="{{ a3b.href }}"><span class="dot {{ 'pass' if a3b.success is sameas true else 'fail' if a3b.success is sameas false else 'none' }}"></span>A3B</a>{% endif %}
          {% if b7.href %}<a href="{{ b7.href }}"><span class="dot {{ 'pass' if b7.success is sameas true else 'fail' if b7.success is sameas false else 'none' }}"></span>7B</a>{% endif %}
          {% if human.href %}<a href="{{ human.href }}"><span class="dot {{ 'pass' if human.success is sameas true else 'fail' if human.success is sameas false else 'none' }}"></span>Human</a>{% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="provisional">Judge labels are provisional. Assign ordered failure modes and root step on each episode page.</p>
  <p class="footer-hint">Serve: <code>python scripts/serve_review_packet.py {{ packet_id }} --annotator abdoul --babel-sync</code></p>

  <script>
    window.REVIEW_CONFIG = {
      page: "index",
      packetId: {{ packet_id | tojson }},
      storageKeyBase: "taxonomy_discovery_{{ packet_id | replace('-', '_') }}",
      registeredAnnotators: ["abdoul", "raghav"],
      annotator: {{ default_annotator | tojson }},
      apiBase: {{ api_base | tojson }}
    };
  </script>
  <script src="review.js"></script>
  <script>
    (function () {
      "use strict";
      const rows = Array.from(document.querySelectorAll("tbody tr"));
      const search = document.getElementById("f-search");
      const domainSel = document.getElementById("f-domain");
      const countEl = document.getElementById("f-count");
      const chips = Array.from(document.querySelectorAll(".qf"));
      const active = new Set();

      function apply() {
        const q = search.value.trim().toLowerCase();
        const dom = domainSel.value;
        let shown = 0;
        for (const row of rows) {
          let ok = true;
          if (q && !(row.dataset.search || "").includes(q)) ok = false;
          if (ok && dom && row.dataset.domain !== dom) ok = false;
          if (ok && active.has("a3b-fail") && row.dataset.a3b !== "fail") ok = false;
          if (ok && active.has("7b-fail") && row.getAttribute("data-7b") !== "fail") ok = false;
          if (ok && active.has("human-pass") && row.dataset.human !== "pass") ok = false;
          if (ok && active.has("unlabeled") && row.querySelector(".human-status.has-label")) ok = false;
          if (ok && active.has("labeled") && !row.querySelector(".human-status.has-label")) ok = false;
          if (ok && active.has("judges-disagree") && row.dataset.judgesDisagree !== "1") ok = false;
          if (ok && active.has("batch") && row.dataset.batch !== "1") ok = false;
          row.style.display = ok ? "" : "none";
          if (ok) shown += 1;
        }
        countEl.textContent = shown + " / " + rows.length + " tasks";
      }

      search.addEventListener("input", apply);
      domainSel.addEventListener("change", apply);
      for (const chip of chips) {
        chip.addEventListener("click", () => {
          const f = chip.dataset.f;
          if (active.has(f)) { active.delete(f); chip.classList.remove("active"); }
          else { active.add(f); chip.classList.add("active"); }
          apply();
        });
      }
      apply();
    })();
  </script>
</body>
</html>
