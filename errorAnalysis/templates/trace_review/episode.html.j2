<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ model | upper }} · {{ domain }}/{{ task_id[:8] }}</title>
  <link rel="stylesheet" href="../../review.css">
</head>
<body>
  <div class="nav navbar">
    <a href="../../index.html">← Index</a>
    {% if siblings %}
    {% for sib in siblings %}<a class="sib-link" href="../../{{ sib.href }}"><span class="model-tag m-{{ sib.model }}">{{ sib.model | upper }}</span> same task</a>{% endfor %}
    {% elif sibling_href %}<a href="../../{{ sibling_href }}">↔ Same task ({{ sibling_model | upper }})</a>{% endif %}
    <span class="nav-spacer"></span>
    {% if prev_link %}<a id="nav-prev" href="{{ prev_link }}">← Previous</a>{% endif %}
    {% if next_link %}<a id="nav-next" href="{{ next_link }}">Next →</a>{% endif %}
  </div>

  <header class="panel ep-header">
    <div class="ep-titlebar">
      <span class="model-tag m-{{ model }}">{{ model | upper }}{% if model == 'human' %} replay{% endif %}</span>
      {% if success %}<span class="pill pill-pass">pass</span>
      {% elif success is none %}<span class="pill">unknown</span>
      {% else %}<span class="pill pill-fail">FAIL</span>{% endif %}
      <span class="pill">{{ steps | length }} steps</span>
      <span class="pill">{{ domain }}</span>
      <code class="mono-id" title="{{ episode_id }}">{{ task_id }}</code>
    </div>
    {% if instruction %}
    <p class="instr-big">{{ instruction }}</p>
    {% endif %}
    {% if result_raw %}<p class="meta">evaluator: {{ result_raw }}</p>{% endif %}
  </header>

  <section class="panel judge-panel">
    <h2>Judge / pipeline attribution (provisional)</h2>
    <div class="kv"><span class="k">modes (priority)</span><span>{{ judge_modes_ordered | join(' → ') or '—' }}</span></div>
    <div class="kv"><span class="k">t*</span><span>{{ t_star if t_star is not none else '—' }}</span></div>
    <div class="kv"><span class="k">propagated</span><span>{{ propagated }}</span></div>
    {% if tier_used %}<div class="kv"><span class="k">tier</span><span>{{ tier_used }}</span></div>{% endif %}
    {% if confidence is not none %}<div class="kv"><span class="k">confidence</span><span>{{ confidence }}</span></div>{% endif %}
    {% if evidence %}
    <details class="reasoning-details">
      <summary>Judge reasoning</summary>
      <div class="evidence">{{ evidence }}</div>
    </details>
    {% endif %}
  </section>

  {% if offline_judges %}
  <section class="panel offline-panel">
    <h2>Offline whole-trajectory judges</h2>
    <p class="hint">Local VLM judges (trajectory_judge, snake_case taxonomy) run on the 50-step
      HF trajectories of this task — failing-step indices refer to that run, not the trace below.</p>
    <div class="judges">
      {% for name, judge in offline_judges.items() %}
      <div class="judge-card">
        <h3><span class="judge-tag jt-{{ loop.index }}">{{ name }}</span></h3>
        <div class="kv"><span class="k">category</span><span>{{ judge.category or '?' }}</span></div>
        <div class="kv"><span class="k">primary mode</span><span><strong>{{ judge.primary_failure_mode or '?' }}</strong></span></div>
        <div class="kv"><span class="k">failing step</span><span>{{ judge.failing_step if judge.failing_step is not none else '?' }}{% if judge.num_steps %} / {{ judge.num_steps }}{% endif %}</span></div>
        <div class="kv"><span class="k">confidence</span><span>{{ judge.confidence if judge.confidence is not none else '?' }}</span></div>
        {% if judge.secondary_failure_modes %}
        <div class="kv"><span class="k">secondary</span><span>{{ judge.secondary_failure_modes | join(', ') }}</span></div>
        {% endif %}
        {% if judge.analysis %}
        <details class="reasoning-details">
          <summary>analysis</summary>
          <div class="evidence">{{ judge.analysis }}</div>
        </details>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="panel human-panel">
    <h2>Your taxonomy discovery label</h2>
    <p class="hint">Select all failure modes that apply, in priority order (1 = primary root cause). Root step may differ from pipeline t*.</p>

    <div class="toolbar annotator-toolbar">
      <label>Annotator
        <select id="annotator-select" class="annotator-select"></select>
      </label>
      <span id="annotator-banner" class="annotator-banner"></span>
      <span id="partner-label-badge" class="partner-badge"></span>
    </div>

    <div class="form-grid">
      <label>Root failure step<input type="number" id="root-step" min="1" placeholder="e.g. 3"></label>
      <label>Your confidence (0–1)<input type="number" id="human-confidence" min="0" max="1" step="0.05" placeholder="0.85"></label>
    </div>

    <div class="modes-picker">
      <label>Add failure mode
        <select id="add-mode-select">
          <option value="">— select leaf —</option>
          {% for leaf in taxonomy_leaves %}
          <option value="{{ leaf }}">{{ leaf }}</option>
          {% endfor %}
        </select>
      </label>
      <button type="button" id="add-mode-btn" class="btn">Add</button>
      <ol id="human-modes-list" class="mode-list"></ol>
    </div>

    <label class="block">Your reasoning (why these modes, why this root step)
      <textarea id="human-reasoning" rows="5" placeholder="Explain what you observed in the trace…"></textarea>
    </label>

    <div class="form-grid checkboxes">
      <label><input type="checkbox" id="is-propagated"> Symptom is propagated (not root cause)</label>
      <label>Propagated from step<input type="number" id="propagated-from-step" min="1"></label>
      <label><input type="checkbox" id="evaluator-mismatch"> Evaluator mismatch</label>
    </div>

    <label class="block">Taxonomy friction / overlap notes
      <textarea id="taxonomy-issue" rows="2" placeholder="e.g. overlaps Reasoning Drift vs false success…"></textarea>
    </label>
    <label class="block">Candidate new leaf (proposal only)
      <input type="text" id="candidate-new-leaf" placeholder="Optional">
    </label>
    <label class="block">Other notes<textarea id="notes" rows="2"></textarea></label>

    <div class="toolbar">
      <button type="button" id="btn-save" class="btn btn-primary">Save label</button>
      <button type="button" id="btn-export" class="btn">Export JSON</button>
      <label class="btn btn-file">Import<input type="file" id="import-file" accept=".json"></label>
      <span id="save-status"></span>
    </div>
  </section>

  <section class="panel">
    <h2>Step timeline ({{ steps | length }} steps) — click step # to set root step</h2>
    {% for step in steps %}
    <article class="step{% if step.is_t_star %} t-star{% endif %}" data-step="{{ step.step_num }}">
      <div class="step-head">
        <span>Step {{ step.step_num }} <button type="button" class="btn-link set-root-step">set as root</button></span>
        {% if step.is_t_star %}<span class="t-star-badge">pipeline t*</span>{% endif %}
      </div>
      <div class="step-body">
        <div class="shot">
          {% if step.screenshot %}
          <img src="{{ step.screenshot }}" alt="Step {{ step.step_num }}" loading="lazy">
          {% else %}
          <div class="noimg">no screenshot</div>
          {% endif %}
        </div>
        <div class="step-detail">
          {% if step.action %}<div class="action">{{ step.action }}</div>{% endif %}
          {% if step.code %}<pre class="codeblock">{{ step.code }}</pre>{% endif %}
          {% if step.thought %}
          {% if step.thought | length > 280 %}
          <details class="reasoning-details">
            <summary>reasoning</summary>
            <div class="thought">{{ step.thought }}</div>
          </details>
          {% else %}
          <div class="thought">{{ step.thought }}</div>
          {% endif %}
          {% endif %}
          <p class="meta stepmeta">reward={{ step.reward }} · done={{ step.done }}</p>
        </div>
      </div>
    </article>
    {% endfor %}
  </section>

  <div id="lightbox">
    <span id="lb-close">✕</span>
    <span class="lb-nav" id="lb-prev">‹</span>
    <img id="lb-img" src="" alt="">
    <span class="lb-nav" id="lb-next">›</span>
    <div id="lb-cap"></div>
  </div>

  <script>
    window.REVIEW_CONFIG = {
      page: "episode",
      packetId: {{ packet_id | tojson }},
      labelKey: {{ label_key | tojson }},
      storageKeyBase: "taxonomy_discovery_{{ packet_id | replace('-', '_') }}",
      registeredAnnotators: ["abdoul", "raghav"],
      annotator: {{ default_annotator | tojson }},
      apiBase: {{ api_base | tojson }}
    };
    document.querySelectorAll(".set-root-step").forEach((btn) => {
      btn.addEventListener("click", () => {
        const step = btn.closest(".step")?.dataset?.step;
        if (step) document.getElementById("root-step").value = step;
      });
    });

    (function () {
      "use strict";
      // ←/→ jump to prev/next episode when the lightbox is closed.
      document.addEventListener("keydown", (e) => {
        if (/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName)) return;
        const lb = document.getElementById("lightbox");
        if (lb && lb.style.display === "flex") return;
        if (e.key === "ArrowLeft") document.getElementById("nav-prev")?.click();
        if (e.key === "ArrowRight") document.getElementById("nav-next")?.click();
      });
    })();

    (function () {
      "use strict";
      const shots = Array.from(document.querySelectorAll(".step-body img")).map((img) => ({
        src: img.getAttribute("src"),
        step: img.closest(".step")?.dataset?.step || "?",
        el: img,
      }));
      if (!shots.length) return;
      const lb = document.getElementById("lightbox");
      const lbImg = document.getElementById("lb-img");
      const lbCap = document.getElementById("lb-cap");
      let idx = 0;

      function show(i) {
        idx = (i + shots.length) % shots.length;
        lbImg.src = shots[idx].src;
        lbCap.textContent = "step " + shots[idx].step + "  (" + (idx + 1) + "/" + shots.length + ")";
      }
      function open(i) { show(i); lb.style.display = "flex"; }
      function close() { lb.style.display = "none"; }

      shots.forEach((s, i) => {
        s.el.classList.add("zoomable");
        s.el.addEventListener("click", () => open(i));
      });
      document.getElementById("lb-close").addEventListener("click", close);
      document.getElementById("lb-prev").addEventListener("click", () => show(idx - 1));
      document.getElementById("lb-next").addEventListener("click", () => show(idx + 1));
      lb.addEventListener("click", (e) => { if (e.target === lb) close(); });
      document.addEventListener("keydown", (e) => {
        if (/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName)) return;
        if (lb.style.display !== "flex") return;
        if (e.key === "ArrowLeft") show(idx - 1);
        if (e.key === "ArrowRight") show(idx + 1);
        if (e.key === "Escape") close();
      });
    })();
  </script>
  <script src="../../review.js"></script>
</body>
</html>
