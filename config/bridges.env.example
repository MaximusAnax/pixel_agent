# Copy to bridges.env and source before running SLURM scripts.
# Allocation confirmed via my_quotas on bridges2-login013.

export BRIDGES_CHARGE_ID=cis260099p
export BRIDGES_PARTITION=GPU-shared
export BRIDGES_GPUS=1
export BRIDGES_CPUS=8
export BRIDGES_MEM=60G
export BRIDGES_TIME=24:00:00

# vLLM
export VLLM_MODEL=xlangai/OpenCUA-7B
export VLLM_SERVED_NAME=opencua-7b
export VLLM_PORT=8000

# Project paths on Ocean (adjust to your $PROJECT)
export CUA_PROJECT_DIR=${PROJECT:-$HOME}/cua-failure-analysis
